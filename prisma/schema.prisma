// This is a Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  password       String?        // hashed, for credentials login
  plan           String         @default("free") // free | trial_99 | pro_499 | business_1999
  planExpiresAt  DateTime?
  role           String         @default("user") // user | student | org_admin | superadmin
  studentId      String?        // college ID number (for student accounts)
  organizationId String?        // FK to Organization (for student accounts)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resumes        Resume[]
  transactions   Transaction[]
}

model Resume {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  template      String   @default("modern")
  accentColor   String   @default("#0f766e")
  fontFamily    String   @default("inter")
  content       String   // JSON string of ResumeData
  isShared      Boolean  @default(false)
  shareToken    String?  @unique
  contactLocked Boolean  @default(false)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  name      String?
  subject   String
  message   String
  status    String   @default("open") // open | replied | resolved
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Organizations / Colleges / Institutions — for bulk student account creation
model Organization {
  id           String   @id @default(cuid())
  name         String   // e.g. "IIT Bombay"
  type         String   @default("college") // college | university | institute | company
  uniqueCode   String   @unique // unique code used in student password = studentId + uniqueCode
  contactEmail String?
  contactPhone String?
  plan         String   @default("pro_499") // default plan given to students
  seats        Int      @default(0) // total seats purchased
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

// Site-wide settings — single-row table (key/value style for flexibility)
model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Transactions — explicit finance ledger
model Transaction {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  plan      String
  amount    Int      // in INR
  status    String   @default("success") // success | pending | failed | refunded
  method    String?  // upi | card | manual | org
  note      String?
  createdAt DateTime @default(now())
}

// Page views / visitor tracking — for traffic analytics
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String?
  device    String?  // mobile | desktop | tablet
  sessionId String?
  userId    String?
  isNew     Boolean  @default(false) // first visit of session
  createdAt DateTime @default(now())
}
